  {
    "slug": "record-demos",
    "title": "Record BusyBuddy Demo Videos",
    "file": ".github/workflows/record-demos.yml",
    "trigger": "workflow_dispatch",
    "description": "One timestamp for the whole run, so every spec's video/trace/\nscreenshot lands in the same videos/<ts>/, traces/<ts>/,\nscreenshots/<ts>/ subfolder instead of overwriting the last run's.",
    "jobs": [
      {
        "name": "record",
        "runsOn": "ubuntu-latest",
        "steps": [
          {
            "name": "actions/checkout@v4",
            "detail": "uses: actions/checkout@v4"
          },
          {
            "name": "actions/setup-node@v4",
            "detail": "uses: actions/setup-node@v4"
          },
          {
            "name": "Install dependencies",
            "detail": "run: npm install"
          },
          {
            "name": "Install Chromium",
            "detail": "run: npx playwright install --with-deps chromium"
          },
          {
            "name": "Restore admin session",
            "detail": "run: echo \"$SHOPIFY_ADMIN_AUTH_STATE\" | base64 -d > auth.json"
          },
          {
            "name": "Set run folder",
            "detail": "run: echo \"DEMO_RUN_FOLDER=$(date -u +%Y-%m-%d_%H-%M-%S)\" >> \"$GITHUB_ENV\""
          },
          {
            "name": "Record demo journeys",
            "detail": "run: npx playwright test ${{ inputs.test_filter }}"
          },
          {
            "name": "Remove admin session before commit",
            "detail": "run: rm -f auth.json"
          },
          {
            "name": "Commit recordings into the repo",
            "detail": "run: git config user.name \"github-actions[bot]\""
          },
          {
            "name": "Upload diagnostic output on failure",
            "detail": "uses: actions/upload-artifact@v4"
          }
        ]
      }
    ],
    "_sourceHash": "c5a9b636a3aa59fcbb175b1e5b0bb8e7ab189490"
  },
